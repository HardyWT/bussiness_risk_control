# ============================================================================
# 电商风险控制系统 ERCS · 环境变量模板
# 用法：复制为 .env 后填写（.env 不入版本控制）
#       cp .env.example .env
# 优先级：环境变量 > .env 文件 > 代码默认值
# ============================================================================

# ---------------------------------------------------------------- 数据库（MySQL 8）
DB_HOST=risk_control
DB_PORT=3306
DB_USER=root
# ⚠ 必填：本机 MySQL 的 root 密码（或专用账号密码）
DB_PASSWORD=root
DB_NAME=ecs
TEST_DB_NAME=ecs_test
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------- AI Agent · LLM
# ⚠ 待项目方补充：阿里云百炼（DashScope）API Key
#    控制台：https://bailian.console.aliyun.com/  → API-KEY 管理
#    留空时 AI 助手走降级路径，**不影响风控主链路与其余页面**
LLM_API_KEY=
LLM_BASE_URL=
# 可选模型：qwen-turbo（快/便宜）、qwen-plus（默认）、qwen-max（精度高）
LLM_MODEL_NAME=qwen-plus
LLM_TEMPERATURE=0.1
# ⚠ 必须 ≥ 模型单轮最长耗时：ReAct 一轮可能串多个工具，且推理模型本身较慢。
#    过小会被归类成 LLM_UNREACHABLE（表现为「连不上」，实为超时）
LLM_TIMEOUT_SECONDS=90
# 思考模式：true=保留模型推理（答案更稳但更慢）
#           false=关闭，实测单轮耗时约降 45~60%、token 减半
LLM_ENABLE_THINKING=true
AGENT_MAX_CONTEXT_MESSAGES=20

# ---------------------------------------------------------------- 决策阈值（五档）
# 0 ~ 29         → Pass 放行
# 30 ~ 59        → Mark 标记观察
# 60 ~ 79        → Challenge 二次验证（全可挑战）/ Review 人审（含不可挑战规则）
# 80 ~ 100       → Reject 拦截
RISK_PASS_THRESHOLD=30
RISK_MARK_THRESHOLD=60
RISK_REVIEW_THRESHOLD=80
RISK_MULTI_RULE_BONUS=3
RISK_VETO_MIN_SCORE=90

# ---------------------------------------------------------------- 认证
# ⚠ 生产环境必须替换
JWT_SECRET=ercs-demo-secret-please-change-in-prod
JWT_EXPIRE_SECONDS=28800
LOGIN_MAX_FAIL=5
LOGIN_LOCK_SECONDS=600

# ---------------------------------------------------------------- 业务
LOSS_DISCOUNT=0.6
CHALLENGE_WINDOW_SECONDS=120
RULE_CACHE_TTL_SECONDS=5
MAX_GRAPH_NODES=50
FEATURE_TIMEOUT_MS=500
FEATURE_TOTAL_BUDGET_MS=200

# ---------------------------------------------------------------- 事件网关（外部调用方）
SERVICE_ID=ercs-demo-service
